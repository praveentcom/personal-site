{
  "name": "personal-site",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "26.x"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "last 2 Opera versions",
    "last 2 ChromeAndroid versions",
    "last 2 iOS versions"
  ],
  "description": "Public personal website and blog for Praveen Thirumurugan.",
  "keywords": [
    "blog",
    "website",
    "praveentcom"
  ],
  "homepage": "https://www.praveent.com",
  "contributors": [
    {
      "name": "Praveen Thirumurugan",
      "email": "mail@praveent.com",
      "url": "https://github.com/praveentcom"
    }
  ],
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8001",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "analyze": "next build --analyze",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "gray-matter": "4.0.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/praveentcom/personal-site.git"
  }
}
